<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow http:// pages inside the in-app web2 browser (WKWebView only).
	     The wallet's own API calls (URLSession) remain https-enforced by ATS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Export compliance: only standard, exempt encryption is used
	     (secp256k1 signing + Apple's Keychain/CryptoKit) — skips the
	     encryption questionnaire on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
